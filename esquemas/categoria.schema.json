{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nombre": {
      "type": "string",
      "minLength": 1
    },
    "padreId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requierePermiso": {
      "type": "boolean",
      "description": "Alimentos, cosméticos y cuidado personal"
    }
  },
  "required": [
    "id",
    "nombre",
    "padreId",
    "requierePermiso"
  ]
}
